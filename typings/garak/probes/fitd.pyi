"""The narrow native FITD hooks required by the controlled run."""

from collections.abc import Iterable
from typing import Any

from garak.attempt import Attempt

class FITD:
    generator: Any
    level_queries_per_goal: dict[str, list[str]]
    num_level_queries: int
    max_calls_per_conv: int
    follow_prompt_cap: bool
    generations: int
    parallel_attempts: int
    def __init__(self) -> None: ...
    def _get_red_team_response(self, prompt: str) -> str: ...
    def _create_init_attempts(self) -> Iterable[Attempt]: ...
    def _execute_all(self, attempts: Iterable[Attempt]) -> Iterable[Attempt]: ...
    def _create_attempt(self, prompt: str) -> Attempt: ...
    def _generate_init_turn(self, target_turn: str) -> str | None: ...
    def _get_level_queries(self, target_turn: str, init_turn: str) -> list[str]: ...
    def _is_refusal(self, response: str) -> bool: ...
    def _postprocess_attempt(self, attempt: Attempt) -> Attempt: ...
    def _verify_is_last_response_success(self, attempt: Attempt) -> list[bool]: ...
    def set_up_refusal_detector(self) -> None: ...
    def probe(self, generator: Any) -> Iterable[Attempt]: ...
