"""Pinned GOAT template and O-T-S-R parsing surface."""

class GOATAttack:
    custom_system_prompt: str | None
    custom_initial_prompt: str | None
    custom_followup_prompt: str | None
    custom_judge_prompt: str | None
    custom_attack_techniques: dict[str, str] | None
    system_prompt_template: str
    initial_prompt_template: str
    followup_prompt_template: str
    judge_prompt_template: str
    attack_techniques: dict[str, str]
    def __init__(self) -> None: ...
    def _get_attack_goals(self) -> list[str]: ...
    def _load_prompt_templates(self) -> None: ...
    def _format_attack_techniques(self) -> str: ...
    def _extract_content(self, content: str) -> str: ...
    def _parse_otsr_response(self, text: str) -> dict[str, str] | None: ...
    def _format_otsr(self, response: dict[str, str]) -> str: ...
