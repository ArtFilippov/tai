"""Minimal inference surface of the pinned Transformers release."""

from typing import Self

import torch

class BatchEncoding(dict[str, torch.Tensor]):
    def to(self, device: torch.device) -> Self: ...

class AutoTokenizer:
    eos_token_id: int
    @classmethod
    def from_pretrained(cls, path: object, *, local_files_only: bool) -> Self: ...
    def apply_chat_template(self, messages: list[dict[str, str]], *, tokenize: bool, add_generation_prompt: bool) -> str: ...
    def __call__(self, prompt: str, *, return_tensors: str) -> BatchEncoding: ...
    def decode(self, tokens: torch.Tensor, *, skip_special_tokens: bool) -> str: ...

class AutoModelForCausalLM:
    @classmethod
    def from_pretrained(cls, path: object, *, local_files_only: bool, torch_dtype: object) -> Self: ...
    def to(self, device: torch.device) -> Self: ...
    def eval(self) -> Self: ...
    def generate(self, *, input_ids: torch.Tensor, attention_mask: torch.Tensor, max_new_tokens: int, do_sample: bool, pad_token_id: int) -> torch.Tensor: ...
