"""Used probe hooks with the native inheritance chain preserved."""

from collections.abc import Iterable, Sequence
from typing import ClassVar, Protocol, override
from ..attempt import Attempt, Conversation, Message
from ..configurable import Configurable

class _LanguageProvider(Protocol):
    @property
    def target_lang(self) -> str: ...
    def get_text(self, prompts: list[str]) -> list[str]: ...

class _Generator(Protocol):
    def generate(self, prompt: Conversation, generations_this_call: int) -> Sequence[Message | None]: ...
    def clear_history(self) -> None: ...

class Probe(Configurable):
    DEFAULT_PARAMS: ClassVar[dict[str, object]]
    parallel_attempts: int
    system_prompt: str | None
    def __init__(self, config_root: object = ...) -> None: ...
    def _get_langprovider(self) -> _LanguageProvider: ...
    def _get_reverse_langprovider(self) -> _LanguageProvider: ...
    def _buff_hook(self, attempts: Iterable[Attempt]) -> Iterable[Attempt]: ...
    def _execute_attempt(self, this_attempt: Attempt) -> Attempt: ...
    def _execute_all(self, attempts: Iterable[Attempt]) -> list[Attempt]: ...
    def _postprocess_attempt(self, this_attempt: Attempt) -> Attempt: ...
    def probe(self, generator: _Generator) -> Iterable[Attempt]: ...

class IterativeProbe(Probe):
    follow_prompt_cap: bool
    attempt_queue: list[Attempt]
    def _create_attempt(self, prompt: str | Conversation) -> Attempt: ...
    def _create_init_attempts(self) -> Iterable[Attempt]: ...
    def _generate_next_attempts(self, last_attempt: Attempt) -> Iterable[Attempt]: ...
    @override
    def probe(self, generator: _Generator) -> list[Attempt]: ...
