"""Pinned FITD hooks, including optional native generation/verification results."""

from collections.abc import Sequence
from typing import override
from ..attempt import Attempt, Conversation
from ..detectors.mitigation import Prefixes
from .base import IterativeProbe

class FITD(IterativeProbe):
    initial_prompt_count: int
    refusal_detector: Prefixes | None
    target_prompts: list[str]
    level_queries_per_goal: dict[str, list[str]]
    def _get_red_team_response(self, prompt: str) -> str | None: ...
    def _is_refusal(self, response: str) -> bool: ...
    def _is_response_aligned(self, request: str, response: str) -> bool: ...
    def _is_realign_prompt(self, prompt: str) -> bool: ...
    def _generate_init_turn(self, target_turn: str, max_tries: int = ...) -> str | None: ...
    def _get_level_queries(self, target_turn: str, init_turn: str) -> list[str]: ...
    @override
    def _create_init_attempts(self) -> list[Attempt]: ...
    def _verify_is_last_response_success(self, attempt: Attempt) -> Sequence[bool | None]: ...
    @override
    def _generate_next_attempts(self, last_attempt: Attempt) -> list[Attempt]: ...
    def generate_next_turn_attempt(self, conversation: Conversation, last_attempt: Attempt) -> Attempt | None: ...
    def set_up_attack_gen_llm(self) -> None: ...
    def set_up_detector(self) -> None: ...
    def set_up_refusal_detector(self) -> None: ...
